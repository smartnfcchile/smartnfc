generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  COMPANY_OWNER
  COMPANY_ADMIN
  COLLABORATOR
}

enum NfcStatus {
  PENDIENTE_GRABACION
  GRABADA
  ENVIADA
  ENTREGADA
  ACTIVA
  SUSPENDIDA
}

enum PlanType {
  FREE
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

enum EventType {
  VIEW
  NFC_SCAN
  WHATSAPP_CLICK
  PHONE_CLICK
  EMAIL_CLICK
  LINK_CLICK
  VCARD_DOWNLOAD
  CONTACT_SHARED
  PROFILE_SHARED
}

model Company {
  id               String                      @id @default(cuid())
  name             String
  slug             String?                     @unique
  plan             PlanType                    @default(FREE)
  isActive         Boolean                     @default(true)
  users            User[]
  cards            Card[]
  physicalNfcCards PhysicalNfcCard[]
  localCampaigns   LocalCampaign[]
  productLicenses  CompanyProductLicense[]
  broadcastBatches LocalBroadcastExportBatch[]
  leads            Lead[]
  leadInteractions LeadInteraction[]

  // Control de licencias y capacidades (Requisito 9)
  maxIdentities Int       @default(5)
  licenseStatus String    @default("ACTIVE") // ACTIVE, SUSPENDED, TRIAL, CANCELLED
  licenseStart  DateTime?
  licenseEnd    DateTime?
  internalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id       String   @id @default(cuid())
  name     String?
  email    String   @unique
  password String?
  role     UserRole @default(COLLABORATOR)
  isActive Boolean  @default(true)
  status   String   @default("ACTIVE") // PENDING, ACTIVE, SUSPENDED

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  cards            Card[]
  activationTokens UserActivationToken[]
  resetTokens      PasswordResetToken[]

  // Relaciones de difusión de WhatsApp
  createdBatches    LocalBroadcastExportBatch[] @relation("BatchCreatedByUser")
  confirmedBatches  LocalBroadcastExportBatch[] @relation("BatchConfirmedByUser")
  requestedRemovals LocalBroadcastRemoval[]     @relation("RemovalRequestedByUser")
  completedRemovals LocalBroadcastRemoval[]     @relation("RemovalCompletedByUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Card {
  id            String            @id @default(cuid())
  slug          String            @unique
  name          String
  isActive      Boolean           @default(true)
  physicalCards PhysicalNfcCard[]

  themeColor  String @default("#2563eb")
  themeMode   String @default("dark")
  template    String @default("corporate-1")
  bannerStyle String @default("classic")
  photoStyle  String @default("circle")

  logoUrl   String?
  avatarUrl String?
  coverUrl  String?
  heroImageUrl String?

  profileName String?
  role        String?
  companyName String?
  bio         String?
  location    String?

  videoUrl   String?
  videoTitle String?

  email    String?
  phone    String?
  whatsapp String?

  instagram String?
  facebook  String?
  linkedin  String?
  tiktok    String?
  youtube   String?

  showEmail     Boolean @default(true)
  showPhone     Boolean @default(true)
  showWhatsapp  Boolean @default(true)
  showInstagram Boolean @default(true)
  showFacebook  Boolean @default(true)
  showLinkedin  Boolean @default(true)
  showTiktok    Boolean @default(true)
  showYoutube   Boolean @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  events           Event[]
  leads            Lead[]
  links            CardLink[]
  leadInteractions LeadInteraction[]

  // Configuración de "Compárteme tus datos"
  shareContactEnabled    Boolean @default(false)
  shareContactButtonText String  @default("Compárteme tus datos")
  shareContactIntro      String  @default("Déjame tus datos para mantenernos en contacto.")
  shareContactConfirm    String  @default("¡Gracias! Tus datos fueron enviados correctamente.")
  shareContactConsent    String  @default("Acepto el tratamiento de mis datos personales para fines de contacto comercial.")
  shareContactFields     Json?
  primaryActionType      String  @default("WHATSAPP")
  secondaryActionType    String  @default("SAVE_CONTACT")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CardLink {
  id       String  @id @default(cuid())
  title    String
  url      String
  icon     String?
  order    Int     @default(0)
  isActive Boolean @default(true)

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model PhysicalNfcCard {
  id        String    @id @default(cuid())
  token     String    @unique
  uid       String?   @unique
  status    NfcStatus @default(PENDIENTE_GRABACION)
  batchCode String?

  printedAt   DateTime?
  encodedAt   DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  activatedAt DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  cardId String?
  card   Card?   @relation(fields: [cardId], references: [id])

  localTouchpointId String?          @unique
  localTouchpoint   LocalTouchpoint? @relation(fields: [localTouchpointId], references: [id])

  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id        String    @id @default(cuid())
  eventType EventType
  ipHash    String?
  userAgent String?
  referer   String?

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  physicalCardId String?
  physicalCard   PhysicalNfcCard? @relation(fields: [physicalCardId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model Lead {
  id String @id @default(cuid())

  name     String
  company  String?
  position String?
  email    String?
  phone    String?
  message  String?

  // Campos de CRM y Trazabilidad analítica
  status           String  @default("NUEVO")
  notes            String?
  ipHash           String?
  identityConflict Boolean @default(false)
  conflictDetails  String?

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  companyId       String
  companyRelation Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  interactions LeadInteraction[]

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([companyId, phone])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  entityType  String
  entityId    String
  companyId   String?
  metadata    String?
  createdAt   DateTime @default(now())
}

model UserActivationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

enum LocalCampaignStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum LocalCampaignTemplate {
  URBAN
}

enum LocalSubscriberStatus {
  ACTIVE
  OPTED_OUT
  BLOCKED
}

enum LocalEventType {
  VIEW
  NFC_SCAN
  QR_SCAN
  SUBSCRIPTION
  WHATSAPP_REDIRECT
  VCF_DOWNLOAD
}

model LocalCampaign {
  id        String                @id @default(cuid())
  companyId String
  company   Company               @relation(fields: [companyId], references: [id])
  name      String
  slug      String                @unique
  status    LocalCampaignStatus   @default(DRAFT)
  template  LocalCampaignTemplate @default(URBAN)

  // Configuración de borrador
  logoUrl            String?
  primaryColor       String    @default("#2563eb")
  secondaryColor     String    @default("#d4af37")
  businessName       String?
  clubName           String?
  headline           String?
  subheadline        String?
  address            String?
  whatsappNumber     String?
  whatsappMessage    String?
  benefitLabel       String?
  benefitTitle       String?
  benefitDescription String?
  benefitConditions  String?
  benefitStartAt     DateTime?
  benefitEndAt       DateTime?
  consentText        String?
  consentVersion     Int       @default(1)

  // Configuración publicada
  publishedSnapshot Json?
  publishedVersion  Int       @default(0)
  publishedAt       DateTime?

  touchpoints      LocalTouchpoint[]
  subscribers      LocalSubscriber[]
  events           LocalEvent[]
  broadcastBatches LocalBroadcastExportBatch[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  localConsentRecords LocalConsentRecord[]

  @@index([companyId, status])
}

model LocalTouchpoint {
  id              String           @id @default(cuid())
  campaignId      String
  campaign        LocalCampaign    @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  name            String
  code            String           @unique
  isActive        Boolean          @default(true)
  physicalNfcCard PhysicalNfcCard?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  localEvents LocalEvent[]

  @@index([campaignId, isActive])
}

model LocalSubscriber {
  id                String                     @id @default(cuid())
  campaignId        String
  campaign          LocalCampaign              @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  name              String
  whatsapp          String
  status            LocalSubscriberStatus      @default(ACTIVE)
  firstSubscribedAt DateTime                   @default(now())
  lastSubscribedAt  DateTime                   @default(now())
  lastInteractionAt DateTime                   @default(now())
  consentRecords    LocalConsentRecord[]
  events            LocalEvent[]
  exportItems       LocalBroadcastExportItem[]
  removals          LocalBroadcastRemoval[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, whatsapp])
  @@index([campaignId, status])
  @@index([createdAt])
}

model LocalConsentRecord {
  id             String          @id @default(cuid())
  subscriberId   String
  subscriber     LocalSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
  campaignId     String
  campaign       LocalCampaign   @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  consentVersion Int
  consentText    String
  acceptedAt     DateTime        @default(now())
  revokedAt      DateTime?
  source         String?
  ipHash         String?
  userAgent      String?
  metadata       Json?

  exportItems LocalBroadcastExportItem[]
  removals    LocalBroadcastRemoval[]

  createdAt DateTime @default(now())

  @@index([campaignId, acceptedAt])
  @@index([subscriberId, acceptedAt])
}

model LocalEvent {
  id           String           @id @default(cuid())
  campaignId   String
  campaign     LocalCampaign    @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  touchpointId String?
  touchpoint   LocalTouchpoint? @relation(fields: [touchpointId], references: [id], onDelete: SetNull)
  subscriberId String?
  subscriber   LocalSubscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  eventType    LocalEventType
  ipHash       String?
  userAgent    String?
  referer      String?
  createdAt    DateTime         @default(now())

  @@index([campaignId, eventType, createdAt])
  @@index([touchpointId, createdAt])
  @@index([subscriberId, createdAt])
}

model PublicRateLimit {
  id          String   @id @default(cuid())
  keyHash     String
  action      String
  windowStart DateTime
  count       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([keyHash, action, windowStart])
  @@index([windowStart])
}

enum SmartNfcProduct {
  EMPRESAS
  LOCAL
}

enum ProductLicenseStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum ProductPlanCode {
  EMPRESAS_CONECTA
  EMPRESAS_CRECE
  EMPRESAS_ESCALA
  EMPRESAS_CORPORATIVO
  EMPRESAS_HISTORICO
  LOCAL_IMPULSA
  LOCAL_FUNDADOR
  LOCAL_PERSONALIZADO
}

model CompanyProductLicense {
  id        String               @id @default(cuid())
  companyId String
  company   Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   SmartNfcProduct
  planCode  ProductPlanCode
  status    ProductLicenseStatus @default(ACTIVE)

  includedIdentities        Int?
  authorizedExtraIdentities Int? @default(0)

  includedCampaigns   Int?
  includedBranches    Int?
  includedTouchpoints Int?

  startsAt  DateTime?
  renewsAt  DateTime?
  expiresAt DateTime?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, product])
  @@index([companyId, status])
  @@index([product, status])
}

enum LocalBroadcastBatchStatus {
  EXPORTED
  CONFIRMED
  CANCELLED
}

enum BroadcastRemovalReason {
  OPTED_OUT
  BLOCKED
}

model LocalBroadcastExportBatch {
  id                String                    @id @default(cuid())
  companyId         String
  company           Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  campaignId        String?
  campaign          LocalCampaign?            @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  createdByUserId   String
  createdByUser     User                      @relation("BatchCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime                  @default(now())
  confirmedAt       DateTime?
  confirmedByUserId String?
  confirmedByUser   User?                     @relation("BatchConfirmedByUser", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  status            LocalBroadcastBatchStatus @default(EXPORTED)

  // Garantía real de concurrencia: único lote EXPORTED por compañía/campaña
  activeScopeKey String? @unique

  items LocalBroadcastExportItem[]

  @@index([companyId])
}

model LocalBroadcastExportItem {
  id              String                    @id @default(cuid())
  batchId         String
  batch           LocalBroadcastExportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  subscriberId    String
  subscriber      LocalSubscriber           @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
  consentRecordId String
  consentRecord   LocalConsentRecord        @relation(fields: [consentRecordId], references: [id], onDelete: Restrict)
  createdAt       DateTime                  @default(now())

  @@unique([batchId, subscriberId])
}

model LocalBroadcastRemoval {
  id                String                 @id @default(cuid())
  subscriberId      String
  subscriber        LocalSubscriber        @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
  consentRecordId   String
  consentRecord     LocalConsentRecord     @relation(fields: [consentRecordId], references: [id], onDelete: Restrict)
  reason            BroadcastRemovalReason
  requestedAt       DateTime               @default(now())
  requestedByUserId String
  requestedByUser   User                   @relation("RemovalRequestedByUser", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  completedAt       DateTime?
  completedByUserId String?
  completedByUser   User?                  @relation("RemovalCompletedByUser", fields: [completedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([subscriberId, consentRecordId])
  @@index([subscriberId])
}

enum LeadInteractionType {
  CONTACT_CAPTURE
  RE_ENGAGEMENT
}

enum ContactSource {
  NFC
  QR
  DIRECT
  UNKNOWN
}

model LeadInteraction {
  id              String              @id @default(cuid())
  leadId          String
  cardId          String
  companyId       String
  type            LeadInteractionType
  source          ContactSource       @default(UNKNOWN)
  message         String?             @db.Text
  consentAccepted Boolean             @default(false)
  consentText     String?             @db.Text
  consentAt       DateTime?
  createdAt       DateTime            @default(now())

  lead            Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  card            Card    @relation(fields: [cardId], references: [id], onDelete: Restrict)
  companyRelation Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
  @@index([companyId, createdAt])
  @@index([cardId, createdAt])
}
